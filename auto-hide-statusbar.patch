+    // ===== ADDED FOR AUTO-HIDE STATUSBAR METHODS =====
+    /**
+     * Hides status bar and navigation panel in immersive sticky mode.
+     * This makes the launcher occupy the full screen.
+     */
+    private void hideSystemBars() {
+        View decorView = getWindow().getDecorView();
+        int flags = View.SYSTEM_UI_FLAG_FULLSCREEN
+                | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
+                | View.SYSTEM_UI_FLAG_LAYOUT_STABLE
+                | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY;
+        decorView.setSystemUiVisibility(flags);
+    }
+
+    /**
+     * Shows status bar temporarily (for STATUS_BAR_SHOW_DURATION_MS milliseconds),
+     * then automatically hides it again.
+     * Called when user performs swipe down gesture from top of screen.
+     */
+    private void showSystemBarsTemporarily() {
+        // cancel any previously scheduled hide operation
+        uiHandler.removeCallbacks(hideSystemBarsRunnable);
+
+        View decorView = getWindow().getDecorView();
+        int flags = decorView.getSystemUiVisibility();
+        flags &= ~View.SYSTEM_UI_FLAG_FULLSCREEN;
+        decorView.setSystemUiVisibility(flags);
+
+        if (hideSystemBarsRunnable == null) {
+            hideSystemBarsRunnable = this::hideSystemBars;
+        }
+        uiHandler.postDelayed(hideSystemBarsRunnable, STATUS_BAR_SHOW_DURATION_MS);
+    }
+    // ===== END AUTO-HIDE STATUSBAR METHODS =====
 }
