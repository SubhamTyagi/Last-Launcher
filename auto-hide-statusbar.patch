+                        // reset to avoid triggering multiple times on single swipe
+                        touchStartY = -1f;
+                    }
+                }
+                break;
+
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL:
+                touchStartY = -1f;
+                break;
